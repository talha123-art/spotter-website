# Optional environment overrides — NO API keys or secrets are required.
# Copy to .env if you want to override defaults.

# Set USE_MOCKS=1 to use deterministic mock providers (incl. reproducible No Travel storm cells)
USE_MOCKS=0
ALLOW_MOCK_FALLBACK=1

# Optional upstream base URL overrides (e.g. self-hosted OSRM / Valhalla)
OSRM_BASE_URL=https://router.project-osrm.org
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
OPEN_METEO_BASE_URL=https://api.open-meteo.com
PHOTON_BASE_URL=https://photon.komoot.io
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Descriptive User-Agent sent to public OSM / weather servers
HTTP_USER_AGENT=WeatherAwareTruckRouting/1.0 (https://github.com/ your-email@example.com)
HTTP_TIMEOUT_S=8
HTTP_RETRIES=2

# Optional Redis URL (falls back to in-memory LocMemCache when unset)
# REDIS_URL=redis://localhost:6379/0

# Frontend build-time backend URL (leave empty in dev to use Vite proxy)
# VITE_API_BASE_URL=https://your-backend.onrender.com
